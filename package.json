{
  "author": "eniallator",
  "description": "My personal website's source code",
  "homepage": "https://cdrn.cc/",
  "license": "MIT",
  "name": "personal-website",
  "packageManager": "bun@1.3.5",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "engines": {
    "node": ">=24.8.0"
  },
  "scripts": {
    "build:ts": "bun esbuild.mjs",
    "build:css": "bun cssbuild.mjs",
    "build": "bun run build:ts && bun run build:css",
    "start": "bun dist/index.js",
    "lint": "oxlint ./server ./client",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "findissues": "bun run typecheck && bun run lint && bun run format:check"
  },
  "dependencies": {
    "@octokit/core": "^7.0.7",
    "deep-guards": "^1.4.0",
    "ejs": "^6.0.1",
    "hono": "^4.13.0",
    "niall-utils": "^2.0.0",
    "nodemailer": "^9.0.4"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@types/bun": "^1.3.14",
    "@types/ejs": "^3.1.5",
    "@types/node": "26.1.2",
    "@types/nodemailer": "^8.0.1",
    "esbuild": "^0.28.1",
    "lightningcss": "^1.33.0",
    "oxlint": "^1.77.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eniallator/Personal-Website.git"
  },
  "bugs": {
    "url": "https://github.com/eniallator/Personal-Website/issues"
  }
}
