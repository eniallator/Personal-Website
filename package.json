{
  "author": "eniallator",
  "description": "My personal website's source code",
  "homepage": "https://cdrn.cc/",
  "license": "MIT",
  "name": "personal-website",
  "packageManager": "bun@1.4.0",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "engines": {
    "node": ">=24.8.0"
  },
  "scripts": {
    "build:ts": "bun scripts/esbuild.ts",
    "build:css": "bun scripts/cssbuild.ts",
    "build": "bun run build:ts && bun run build:css",
    "start": "bun dist/index.js",
    "lint": "oxlint ./server ./client ./scripts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "findissues": "bun run typecheck && bun run lint && bun run format:check",
    "lib-docs": "bun scripts/lib-docs.ts",
    "postinstall": "bun run lib-docs"
  },
  "claudeLibDocs": [
    "deep-guards",
    "niall-utils"
  ],
  "dependencies": {
    "@hono/bun": "^1.0.1",
    "@octokit/core": "^7.0.8",
    "deep-guards": "^2.0.0",
    "ejs": "^7.0.2",
    "hono": "^4.13.13",
    "niall-utils": "^4.0.0",
    "nodemailer": "^10.2.1"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@types/bun": "^1.4.4",
    "@types/ejs": "^3.1.5",
    "@types/nodemailer": "^8.0.2",
    "esbuild": "^0.28.2",
    "lightningcss": "^1.33.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  },
  "browserslist": [
    "chrome 100"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eniallator/Personal-Website.git"
  },
  "bugs": {
    "url": "https://github.com/eniallator/Personal-Website/issues"
  }
}
